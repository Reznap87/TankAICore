# ── Hauptmodell ─────────────────────────────────────────────────────────────
# openai | anthropic | mock | echo
# mock/echo sind Simulationen und erzeugen niemals Status "completed".
TANKAI_LLM=mock

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=REPLACE_WITH_MODEL_NAME
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=REPLACE_WITH_MODEL_NAME

# ── Produktionsgrenze für Live-Provider ─────────────────────────────────────
# Cloudflare startet ohne explizite Aktivierung weiterhin ausschließlich mock.
# Erst bei TANKAI_LIVE_PROVIDER_ENABLED=1 werden Provider-/Critic-/Search-Werte
# aus Worker-Bindings an den Container weitergereicht. Secret-Werte gehören in
# Cloudflare Worker Secrets und niemals in diese Datei oder wrangler vars.
TANKAI_LIVE_PROVIDER_ENABLED=0
TANKAI_LLM_MAX_TOKENS=2048
TANKAI_LLM_TIMEOUT_SECONDS=30
TANKAI_LLM_MAX_RETRIES=1
# Separates hartes Budget für einen später ausdrücklich autorisierten Live-Smoke.
TANKAI_LIVE_SMOKE_MAX_TOKENS=256

# ── Separater Critic ────────────────────────────────────────────────────────
# TANKAI_CRITIC_LLM=anthropic
# TANKAI_CRITIC_MODEL=REPLACE_WITH_CRITIC_MODEL
# TANKAI_CRITIC_API_KEY=sk-ant-...
# TANKAI_CRITIC_BASE_URL=
# TANKAI_REQUIRE_INDEPENDENT_CRITIC=1

# ── Webrecherche ────────────────────────────────────────────────────────────
# TANKAI_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=...
# alternativ:
# TANKAI_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=...
TANKAI_REQUIRE_RESEARCH_EVIDENCE=1
# TANKAI_STRICT_WEB_RESEARCH=1
TANKAI_WEB_FETCH=1
TANKAI_WEB_MAX_RESULTS=5
TANKAI_WEB_FETCH_COUNT=3
TANKAI_WEB_TIMEOUT=12
TANKAI_WEB_MAX_BYTES=750000

# ── Webserver und Authentifizierung ─────────────────────────────────────────
TANKAI_HOST=127.0.0.1
TANKAI_PORT=8765
TANKAI_AUTH_MODE=session
TANKAI_DATA_ROOT=.tankai/data
TANKAI_AUTH_DB=.tankai/data/auth.db
TANKAI_SESSION_HOURS=12
# Bei HTTPS immer 1. Auf Loopback-HTTP für lokale Entwicklung 0.
TANKAI_COOKIE_SECURE=0
# Öffentliche Selbstregistrierung bleibt standardmäßig aus.
TANKAI_ALLOW_REGISTRATION=0
TANKAI_LOGIN_ATTEMPTS=5
TANKAI_LOGIN_WINDOW=300
TANKAI_LOGIN_BLOCK=900

# Nur lokale Entwicklung, niemals bei öffentlichem Bind:
# TANKAI_AUTH_MODE=disabled

# ── Workspace-Persistenz ────────────────────────────────────────────────────
# Jeder autorisierte Workspace erhält unter TANKAI_DATA_ROOT einen eigenen
# Satz aus memory.db, ltm.db, vectors.npz, runs.jsonl, web_history.jsonl und cold/.
TANKAI_EMBEDDER=hashing


# ── Persistente Development-Queue / Admission-Control ───────────────────────
# Standardmäßig deaktiviert. Bei Aktivierung muss der Betreiber die drei
# logischen Basisverzeichnisse setzen. Der Webdienst muss diese Verzeichnisse
# nicht mounten; die Werte müssen jedoch mit der Runner-Konfiguration übereinstimmen.
TANKAI_DEV_QUEUE_ENABLED=0
TANKAI_DEV_QUEUE_DB=.tankai/data/development-jobs.db
# TANKAI_REPOSITORY_BASE=/srv/tankai/repositories
# TANKAI_WORKTREE_BASE=/srv/tankai/worktrees
# TANKAI_STATE_BASE=/srv/tankai/states

# ── Development-Worker-Isolation ────────────────────────────────────────────
# Nur auf einem dedizierten nicht-root Runner-Host setzen. Der öffentliche
# Webcontainer darf keinen Docker-/Podman-Socket erhalten.
TANKAI_REQUIRE_WORKER_ISOLATION=1
TANKAI_WORKER_CONTAINER_RUNTIME=docker
