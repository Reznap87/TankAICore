{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tankai-pilot-local-operator",
  "main": "src/pilot-operator.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "services": [{ "binding": "PILOT", "service": "tankai-snapshot-pilot", "remote": true }],
  "dev": { "ip": "127.0.0.1", "port": 8766, "inspector_port": 0, "local_protocol": "http" }
}
