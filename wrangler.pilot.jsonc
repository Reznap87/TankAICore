{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tankai-snapshot-pilot",
  "main": "src/cloudflare-pilot.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "secrets": { "required": ["TANKAI_PILOT_CONTROL_TOKEN"] },
  "containers": [{
    "name": "tankai-snapshot-pilot-native",
    "class_name": "TankAIPilot",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./Dockerfile.pilot", "build_context": "." } }
  }],
  "durable_objects": { "bindings": [{ "name": "TANKAI_PILOT", "class_name": "TankAIPilot" }] },
  "migrations": [{ "tag": "pilot-v1", "new_sqlite_classes": ["TankAIPilot"] }],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } }
}
