{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tankai-core",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tankaicore.com",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "TankAIContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TANKAI_CONTAINER",
        "class_name": "TankAIContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TankAIContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
